# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is listed in .gitignore.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string — add this when your cluster is ready
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-coloring-studio
MONGO_URI=

# Secret key used to sign JWT tokens — use a long random string in production
JWT_SECRET=

# The URL of your frontend app (used by CORS to allow requests)
CLIENT_URL=http://localhost:5173

# Environment: "development" or "production"
NODE_ENV=development

# AI API key (will be added in Phase 6)
# AI_API_KEY=
